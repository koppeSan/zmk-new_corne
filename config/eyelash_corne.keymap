#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10
#define MOVE_SLOW 600   // slow cursor move (Mouse layer, left hand)
#define MOVE_DIAG 250   // diagonal cursor move (Mouse layer)
#define SCRL_FAST 150   // fast scroll (Mouse layer)

#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "unicode.h"
#include "keycode_japanese.h"
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Mouse move / scroll speed can be tuned at runtime from DYA Studio.
// Initial scale keeps the previous static setting (zip_xy_scaler / zip_scroll_scaler 2 1).
&mouse_runtime_input_processor {
    scale-multiplier = <2>;
    scale-divisor = <1>;
};

&scroll_runtime_input_processor {
    scale-multiplier = <2>;
    scale-divisor = <1>;
};

&mmv_input_listener { input-processors = <&mouse_runtime_input_processor>; };

&msc_input_listener { input-processors = <&scroll_runtime_input_processor>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        // Existing Shift/Caps Lock tap dance (renamed from td0, used on the NumPad layer)
        td_caps: td_caps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        // Tap dances for assigning from DYA Studio
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "TD ESC/ENTER";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp ENTER>;
        };

        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "TD C/V";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp C>, <&kp V>;
        };

        td2: td2 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "TD J/K";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp J>, <&kp K>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        gmail_address: gmail_address {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&none &kp K &kp N2 &kp DOT &kp D &kp R &kp U &kp M &kp S &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M &kp TAB>,
                <&macro_tap>;

            label = "GMAIL_ADDRESS";
        };
    };

    combos {
        compatible = "zmk,combos";

        printScreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <13 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB        &kp Q  &kp W  &kp E     &kp R                   &kp T                               &kp UP                 &kp Y        &kp U       &kp I         &kp O    &kp P      &kp ESC
&kp LGUI       &kp A  &kp S  &kp D     &kp F                   &kp G            &kp LEFT           &kp DELETE  &kp RIGHT  &kp H        &kp J       &kp K         &kp L    &kp MINUS  &kp PAGE_UP
&lt 3 JP_ZKHK  &kp Z  &kp X  &kp C     &kp V                   &kp B            &lt 6 PRINTSCREEN  &kp DOWN               &kp N        &kp M       &kp COMMA     &kp DOT  &kp FSLH   &kp PAGE_DOWN
                             &kp LALT  &mt LEFT_SHIFT JP_ZKHK  &mt LCTRL SPACE                                            &lt 2 ENTER  &lt 4 BSPC  &lt 1 DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        MouseLayer {
            display-name = "Mouse";
            bindings = <
&kp C_VOL_UP  &kp C_BRIGHTNESS_INC  &mmv MOVE(-MOVE_DIAG, -MOVE_DIAG)  &mmv MOVE_Y(-MOVE_SLOW)  &mmv MOVE(MOVE_DIAG, -MOVE_DIAG)  &none                   &mmv MOVE_UP                     &msc MOVE_X(-SCRL_FAST)  &msc MOVE_Y(SCRL_FAST)  &msc MOVE_Y(-SCRL_FAST)  &msc MOVE_X(SCRL_FAST)  &mt HOME PAGE_UP   &kp LC(W)
&kp C_VOL_DN  &kp C_BRIGHTNESS_DEC  &mmv MOVE_X(-MOVE_SLOW)            &mmv MOVE_Y(MOVE_SLOW)   &mmv MOVE_X(MOVE_SLOW)            &none   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &mmv MOVE_LEFT           &mkp LCLK               &mkp RCLK                &mkp MCLK               &mt END PAGE_DOWN  &kp LC(PAGE_UP)
&kp C_MUTE    &none                 &mmv MOVE(-MOVE_DIAG, MOVE_DIAG)   &mmv MOVE_Y(MOVE_SLOW)   &mmv MOVE(MOVE_DIAG, MOVE_DIAG)   &none   &kp LC(W)       &mmv MOVE_DOWN                   &mkp MB4                 &mkp MB5                &msc SCRL_DOWN           &kp RIGHT               &trans             &kp LC(PAGE_DOWN)
                                                                       &trans                   &trans                            &trans                                                   &trans                   &kp DEL                 &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LS(LC(TAB))>;
        };

        layer_3 {
            display-name = "Fn&Cur";
            bindings = <
&studio_unlock  &trans  &kp F1  &kp F2   &kp F3   &kp F4                   &mmv MOVE_UP                     &kp END       &kp LA(UP)     &kp UP       &kp LA(F4)   &kp JP_TILDE  &kp DELETE
&trans          &trans  &kp F5  &kp F6   &kp F7   &kp F8   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp HOME      &kp LEFT       &kp DOWN     &kp RIGHT    &kp JP_UNDER  &kp PAGE_UP
&trans          &trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp LA(F4)      &mmv MOVE_DOWN                   &kp LA(LEFT)  &kp LA(RIGHT)  &kp LC(TAB)  &kp LC(TAB)  &kp JP_PIPE   &kp PAGE_DOWN
                                &trans   &trans   &trans                                                    &trans        &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LS(LC(TAB))>;
        };

        BT_setting {
            display-name = "BT_LED";
            bindings = <
&trans  &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &mmv MOVE_UP                     &kp N6           &kp PG_UP  &kp UP           &msc SCRL_UP     &kp N0           &kp ESC
&trans  &bt BT_PRV       &bt BT_NXT      &none         &none         &none           &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &rgb_ug RGB_EFF  &none      &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI
&trans  &rgb_ug RGB_TOG  &rgb_ug RGB_ON  &bt BT_CLR    &trans        &none           &kp LC(W)       &mmv MOVE_DOWN                   &rgb_ug RGB_EFR  &none      &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD
                                         &trans        &trans        &bt BT_CLR_ALL                                                   &rgb_ug RGB_TOG  &kp DEL    &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LS(LC(TAB))>;
        };

        NumSYM {
            display-name = "NumSym";
            bindings = <
&trans  &mt JP_BSLH JP_YEN  &kp JP_GRAVE  &kp JP_LBRC  &kp JP_RBRC  &kp JP_CARET                  &mmv MOVE_UP                         &kp TAB       &kp N7  &kp N8  &kp N9  &kp N0        &kp BSPC
&trans  &kp JP_AT           &kp JP_DQT    &kp JP_LPAR  &kp JP_RPAR  &kp JP_COLON  &mmv MOVE_LEFT  &mkp LCLK           &mmv MOVE_RIGHT  &kp JP_PLUS   &kp N4  &kp N5  &kp N6  &kp JP_MINUS  &kp GRAVE
&trans  &kp JP_EXCL         &kp JP_SQT    &kp JP_LBKT  &kp JP_RBKT  &kp SEMI      &mmv MOVE_DOWN  &mt JP_EQUAL KP_N0                   &kp JP_ASTRK  &kp N1  &kp N2  &kp N3  &kp FSLH      &kp DELETE
                                          &kp SPACE    &trans       &trans                                                             &trans        &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        layer_4 {
            display-name = "NumPad";
            bindings = <
&kp GRAVE       &kp JP_TILDE  &kp JP_AT     &kp JP_LBRC  &kp JP_RBRC  &kp JP_SEMI                          &kp PG_UP            &kp TAB         &kp N7    &kp N8     &kp N9  &kp JP_ASTRK  &kp BACKSPACE
&trans          &kp JP_EXCL   &kp JP_SQT    &kp JP_LPAR  &kp JP_RPAR  &kp JP_COLON  &kp HOME               &bl BL_TOG  &kp END  &kp JP_PLUS     &kp N4    &kp N5     &kp N6  &kp JP_MINUS  &kp JP_EQUAL
&kp LEFT_SHIFT  &kp JP_CARET  &kp JP_GRAVE  &kp JP_LBKT  &kp JP_RBKT  &kp JP_BSLH   &kp C_BRIGHTNESS_AUTO  &kp PG_DN            &kp N0          &kp N1    &kp N2     &kp N3  &kp JP_SLASH  &kp JP_CARET
                                            &trans       &trans       &trans                                                    &kp LEFT_SHIFT  &td_caps  &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        layer_6 {
            display-name = "shftSYM";
            bindings = <
&trans  &kp JP_EXCL   &kp JP_AT     &kp JP_HASH  &kp JP_DLLR  &kp JP_PRCNT                  &mmv MOVE_UP                         &kp JP_CARET        &kp JP_AMPS  &kp JP_ASTRK  &kp JP_LPAR   &kp JP_CARET  &kp BSPC
&trans  &kp JP_EXCL   &kp JP_SQT    &kp JP_RBRC  &kp JP_RPAR  &kp JP_RBKT   &mmv MOVE_LEFT  &mkp LCLK           &mmv MOVE_RIGHT  &kp JP_PLUS         &kp JP_DLLR  &kp JP_PRCNT  &kp JP_CARET  &kp JP_UNDER  &kp GRAVE
&trans  &kp JP_CARET  &kp JP_GRAVE  &kp JP_BSLH  &kp JP_SEMI  &kp JP_TILDE  &mmv MOVE_DOWN  &mt ENTER JP_EQUAL                   &mt ENTER JP_EQUAL  &kp JP_EXCL  &kp JP_AT     &kp JP_HASH   &kp JP_PRCNT  &trans
                                    &trans       &trans       &trans                                                             &trans              &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        // Reserved layers: can be enabled/edited later from ZMK Studio / DYA Studio
        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };

        extra3 {
            status = "reserved";
        };

        extra4 {
            status = "reserved";
        };
    };
};
